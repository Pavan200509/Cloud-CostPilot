# Cloud CostPilot — live GCP discovery + Gemini recommendations
# Copy to backend/.env (never commit real keys)

DISCOVERY_MODE=live
STORAGE_BACKEND=local
AI_PROVIDER=gemini
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Required for Gemini recommendations (AI Studio free-tier key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional default project hint (user still connects in UI)
GCP_PROJECT_ID=

# Local: Application Default Credentials
#   gcloud auth application-default login
# Cloud Run: attach a runtime SA with compute.viewer + resourcemanager.viewer

CPU_UNDERUTILIZED_PCT=20
REFRESH_INTERVAL_SECONDS=300
SESSION_TTL_HOURS=24